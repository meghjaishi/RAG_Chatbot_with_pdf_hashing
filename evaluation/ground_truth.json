    "q20": {
      "id": "q20",
      "question": "What are the main steps in the MAML training algorithm?",
      "reference_answer": "MAML samples tasks, evaluates each task loss using a small number of examples, computes adapted parameters through gradient descent, evaluates the adapted models, and then updates the shared initial parameters using the meta-objective across the sampled tasks.",
